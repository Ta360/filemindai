# ---------------------------------------------------------------------------
# Google Drive LLM AI Assistant — Backend environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Random long secret used to sign the local session cookie
SESSION_SECRET=replace_with_a_long_random_string

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth / Drive API
# Create these in Google Cloud Console (see README.md "Google Cloud Setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Web Search provider (pluggable — see src/services/webSearch)
# Supported: "serper" | "tavily" | "none"
WEB_SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Database (SQLite file path by default; swap for PostgreSQL/Supabase later)
DATABASE_URL=./data/app.db

# ---------------------------------------------------------------------------
# AI Agents (Google / YouTube / Instagram) — see README.md "AI Agents Setup"
# ---------------------------------------------------------------------------

# YouTube Data API v3 key — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Instagram Graph API (Instagram Login) app — connects the user's OWN account
# only. Create at https://developers.facebook.com/apps -> add "Instagram" product.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/agents/instagram/callback

# Matplotlib chart microservice (run `python charts-service/app.py`)
CHART_SERVICE_URL=http://localhost:5001

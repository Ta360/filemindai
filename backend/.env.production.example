# ---------------------------------------------------------------------------
# Production environment for filemindai.org — copy to "backend/.env" ON THE
# VPS ITSELF (never commit it, never paste real values into chat/AI tools).
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=production
FRONTEND_URL=https://filemindai.org
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth / Drive API — this is a SEPARATE OAuth client from your local
# dev one. Create it in Google Cloud Console with:
#   Authorized JavaScript origin:  https://filemindai.org
#   Authorized redirect URI:       https://filemindai.org/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://filemindai.org/api/auth/callback

# Web Search provider (same Serper/Tavily key works across environments)
WEB_SEARCH_PROVIDER=serper
SEARCH_API_KEY=

DATABASE_URL=./data/app.db

# YouTube Data API v3 (same key works across environments, or make a
# separate one restricted to this domain if you prefer)
YOUTUBE_API_KEY=

# Instagram Graph API — also needs its own redirect URI added in the Meta
# Developer app settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://filemindai.org/api/agents/instagram/callback

# Inside docker-compose.prod.yml the chart service is reachable by its
# service name on the internal network, not localhost.
CHART_SERVICE_URL=http://charts:5001
